# Long cache for hashed build files, no cache for the page itself.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
AddType image/svg+xml .svg

# The repository root is the web root: don't serve the sources next to the built site.
RedirectMatch 404 ^.*/(src|app|tests|node_modules|\.git|\.github)(/.*)?$
RedirectMatch 404 ^.*/(package(-lock)?\.json|tsconfig\.json|vite\.config\.ts|README\.md|\.gitignore)$
